# .env.local にコピーして使う
# 各ポートで何を動かすかは README.md の「必要な環境」を参照

VLM_ENDPOINT=http://127.0.0.1:8084
LLM_ENDPOINT=http://127.0.0.1:8080
EMBED_ENDPOINT=http://127.0.0.1:8082

# シーン検出の閾値（スライド動画のように変化が緩やかな素材では 0.2 程度が必要）
SCENE_THRESHOLD=0.2
# 1本の動画から取り出すフレームの上限（超過分は等間隔に間引く）
MAX_FRAMES=16
# アップロードできる動画のサイズ上限(MB)
MAX_UPLOAD_MB=500

# 画面録画はシーン検出がほとんど反応しないため、検出数がこの枚数に届かなければ
# 等間隔抽出にフォールバックする
MIN_SCENE_FRAMES=3
# 等間隔抽出のときの目安の間隔(秒)
INTERVAL_SECONDS=10
# 抽出フレームの最大幅。VLM の prompt トークン数と処理時間に直結する
FRAME_MAX_WIDTH=1600

# 質問応答でテキストでは答えられないとき、Qwen3-VL に見直させるフレーム数
# （1フレーム5〜7秒かかるので、増やすほど回答が遅くなる）
ASK_VLM_FRAMES=2

# 音声認識（whisper.cpp）。未設定なら文字起こしをスキップする。
# 事前に `brew install whisper-cpp` と ggml モデルの用意が必要
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo-q5_0.bin
WHISPER_LANGUAGE=ja

# 操作マニュアル自動生成（/manual）
# 発話の区切れ目を足したあとのフレーム数上限。MAX_FRAMES とは別にしてあるのは、
# selectFrameTimes の戻り値がすでに MAX_FRAMES で間引かれており、
# 同じ値を使うと発話由来のフレームを足す余地が無くなるため。
# 1枚5〜7秒かかるので、24枚なら画面の解析だけで2〜3分かかる
MANUAL_MAX_FRAMES=24
# フレーム時刻の最小間隔(秒)。これより近い発話開始時刻は同じ画面とみなして捨てる
MANUAL_MIN_FRAME_GAP=2

# スクリーンショット注釈サブエージェント（/api/manual/annotate）の並列度。
# VLM(8084) は4スロットだが、1スロットは QaChat（/api/ask）用に空けておく
MANUAL_ANNOTATE_CONCURRENCY=3

# スクリーンショット検証サブエージェント（/api/manual/verify）の並列度。
# 1手順あたり「現在の画像+新規候補」を複数枚同時にVLMへ送るぶん annotate より
# 1リクエストが重いので、既定を1段階下げてある
MANUAL_VERIFY_CONCURRENCY=2
