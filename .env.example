# .env.local にコピーして使う
# 各ポートで何を動かすかは README.md の「必要な環境」を参照

VLM_ENDPOINT=http://127.0.0.1:8084
LLM_ENDPOINT=http://127.0.0.1:8080
EMBED_ENDPOINT=http://127.0.0.1:8082

# シーン検出の閾値（スライド動画のように変化が緩やかな素材では 0.2 程度が必要）
SCENE_THRESHOLD=0.2
# 1本の動画から取り出すフレームの上限（超過分は等間隔に間引く）
MAX_FRAMES=16
# アップロードできる動画のサイズ上限(MB)
MAX_UPLOAD_MB=500

# 画面録画はシーン検出がほとんど反応しないため、検出数がこの枚数に届かなければ
# 等間隔抽出にフォールバックする
MIN_SCENE_FRAMES=3
# 等間隔抽出のときの目安の間隔(秒)
INTERVAL_SECONDS=10
# 抽出フレームの最大幅。VLM の prompt トークン数と処理時間に直結する
FRAME_MAX_WIDTH=1600

# 質問応答でテキストでは答えられないとき、Qwen3-VL に見直させるフレーム数
# （1フレーム5〜7秒かかるので、増やすほど回答が遅くなる）
ASK_VLM_FRAMES=2
